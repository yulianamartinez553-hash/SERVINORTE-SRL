# =============================================================================
# SERVINORTE - Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# Neon Database or any PostgreSQL connection string
DATABASE_URL="postgresql://username:password@ep-xxxx.us-east-1.aws.neon.tech/servinorte?sslmode=require"

# -----------------------------------------------------------------------------
# GOOGLE APIS (Required)
# -----------------------------------------------------------------------------
# Service Account JSON key (entire JSON as a single-line string)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Google Sheets Spreadsheet ID (from the URL: /spreadsheets/d/SPREADSHEET_ID/)
GOOGLE_SPREADSHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms"

# Google Maps JavaScript API Key (browser-safe, restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# -----------------------------------------------------------------------------
# ADMIN PANEL (Required)
# -----------------------------------------------------------------------------
# Admin panel password (use a strong password in production)
ADMIN_PASSWORD="change-this-to-a-strong-password"

# JWT secret for admin sessions (use a random 64-char string)
JWT_SECRET="generate-a-random-64-character-string-for-jwt-signing-here-xxxx"

# -----------------------------------------------------------------------------
# APPLICATION (Optional)
# -----------------------------------------------------------------------------
# Next.js public URL (set in production)
NEXTAUTH_URL="https://actualizacion.servinorte.com.ar"

# Environment
NODE_ENV="production"
